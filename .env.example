# ===========================================================================
# CANONICAL ENVIRONMENT VARIABLES - implementation-ai
# Canonical names only. Never invent alternative names for these.
# ===========================================================================

# --- Shared PocketBase instance (server-only) -----------------------------
SYNKRA_PB_URL=https://<shared-instance-host>

# --- Synkra OS base URL this worker posts job results to ------------------
SYNKRA_APP_URL=https://<synkra-os-host>

# --- Per-service tokens (one per internal employee, never shared) ---------
# The same variable name must exist here (caller) and in synkra-os
# (validating hook). Generate with a strong random generator, e.g.
#   openssl rand -hex 32
AI_WORKER_API_KEY=
AI_WORKER_API_KEY_CUSTOMER_SUPPORT=
